{
  "realm": "demo",
  "enabled": true,
  "displayName": "auth-from-scratch demo",

  "sslRequired": "NONE",

  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "clients": [
    {
      "clientId": "demo-client",
      "name": "00 first-login-trace / 02 authcode-pkce",
      "description": "Confidential client. Authorization Code + PKCE.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "demo-client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5556/callback"
      ],
      "webOrigins": [
        "http://localhost:5556"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5556/*",
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "demo-api",
      "name": "03 jwks-verification (resource server)",
      "description": "Resource server. Exists so tokens have somewhere to be an audience for.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "demo-api-secret",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {}
    }
  ],

  "roles": {
    "realm": [
      { "name": "hr-viewer", "description": "RBAC 데모용. 표 4의 역할 기반 인가가 토큰에 어떻게 나타나는지 보이려고 있다" },
      { "name": "hr-admin", "description": "RBAC 데모용. alice에게는 주지 않는다 (권한 차이 관찰용)" }
    ]
  },

  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Example",
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ],
      "realmRoles": ["hr-viewer"]
    }
  ]
}
