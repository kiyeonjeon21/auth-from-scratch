{
  "realm": "demo",
  "enabled": true,
  "displayName": "auth-from-scratch demo  \u00b7  \ub85c\uadf8\uc778: alice / alice",

  "sslRequired": "NONE",

  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "clients": [
    {
      "clientId": "demo-client",
      "name": "00 first-login-trace / 02 authcode-pkce",
      "description": "Confidential client. Authorization Code + PKCE.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "demo-client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5556/callback"
      ],
      "webOrigins": [
        "http://localhost:5556"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5556/*",
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "demo-rp-a",
      "name": "04 logout - RP A",
      "description": "로그아웃 챕터의 첫 번째 RP. back-channel logout 수신 URL이 등록돼 있다.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "demo-rp-a-secret",
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:5560/callback"],
      "webOrigins": ["http://localhost:5560"],
      "frontchannelLogout": false,
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5560/*",
        "pkce.code.challenge.method": "S256",
        "backchannel.logout.url": "http://host.docker.internal:5560/backchannel-logout",
        "backchannel.logout.session.required": "true"
      }
    },
    {
      "clientId": "demo-rp-b",
      "name": "04 logout - RP B",
      "description": "두 번째 RP. A에서 로그아웃하면 여기로도 통지가 와야 한다.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "demo-rp-b-secret",
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:5561/callback"],
      "webOrigins": ["http://localhost:5561"],
      "frontchannelLogout": false,
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5561/*",
        "pkce.code.challenge.method": "S256",
        "backchannel.logout.url": "http://host.docker.internal:5561/backchannel-logout",
        "backchannel.logout.session.required": "true"
      }
    },
    {
      "clientId": "demo-api",
      "name": "05 jwks-verify (resource server)",
      "description": "Resource server. Exists so tokens have somewhere to be an audience for.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "demo-api-secret",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {}
    }
  ],

  "roles": {
    "realm": [
      { "name": "hr-viewer", "description": "RBAC 데모용. 표 4의 역할 기반 인가가 토큰에 어떻게 나타나는지 보이려고 있다" },
      { "name": "hr-admin", "description": "RBAC 데모용. alice에게는 주지 않는다 (권한 차이 관찰용)" }
    ]
  },

  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Example",
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ],
      "realmRoles": ["hr-viewer"]
    }
  ]
}
