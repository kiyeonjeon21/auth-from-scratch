{
  "realm": "demo",
  "enabled": true,
  "displayName": "auth-from-scratch demo",

  "sslRequired": "NONE",

  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "clients": [
    {
      "clientId": "demo-client",
      "name": "00 first-login-trace / 02 authcode-pkce",
      "description": "Confidential client. Authorization Code + PKCE.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "demo-client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5556/callback"
      ],
      "webOrigins": [
        "http://localhost:5556"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5556/*",
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "demo-api",
      "name": "03 jwks-verification (resource server)",
      "description": "Resource server. Exists so tokens have somewhere to be an audience for.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "demo-api-secret",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {}
    }
  ],

  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Example",
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ]
    }
  ]
}
